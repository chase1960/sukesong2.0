# 每任务复制一份为 .env（不要提交），五个关键值必须各任务不同：
# COMPOSE_PROJECT_NAME / DB_ROOT_PASSWORD / ADMIN_PASSWORD / 端口 / SHANGSHU_SRC
# 已分配（2026-10-10）：
#   B（Excel 后端测试）      COMPOSE_PROJECT_NAME=shangshu-b-xlsx   NODE_HOST_PORT=3100  FRAPPE_HOST_PORT=3102
#   A（Excel 前后端联调）    COMPOSE_PROJECT_NAME=shangshu-a-int   NODE_HOST_PORT=3200  FRAPPE_HOST_PORT=3202
#   C（邮件完整链）          COMPOSE_PROJECT_NAME=shangshu-c-mail  NODE_HOST_PORT=3300  FRAPPE_HOST_PORT=3302
# 端口不许用 DevHost 占用的 18002/19002/13002/11002 和常见的 3000/8000/8001。

COMPOSE_PROJECT_NAME=shangshu-b-xlsx

# 代码工作树（只读挂载进容器）：B 用自己的工作树，A/C 用自己的
SHANGSHU_SRC=/path/to/workspace

SITE_NAME=shangshu.localhost

# 口令只放本文件（gitignored）或单独 secrets 文件，不进仓库、不进交付证据
DB_ROOT_PASSWORD=change-me-db-root
ADMIN_PASSWORD=change-me-admin
TEST_USER_PASSWORD=change-me-user

# 模型密钥只放本地 .env 或部署 secret，不要提交真实值
SHANGSHU_LLM_API_KEY=

# 宿主端口（每任务错开）
NODE_HOST_PORT=3100
FRAPPE_HOST_PORT=3102
FRAPPE_SOCKETIO_HOST_PORT=3103
