# Frappe bench 运行环境（版本锁见 versions.env；Frappe 源码用本地 tarball，构建不依赖 github 克隆）。
# 首次启动时 entrypoint 把镜像内预置的 bench 复制到数据卷，再跑 init-site.sh 建站装应用。
# 构建前置：先跑 scripts/prepare.sh 把 frappe-v15.118.0.tar.gz 放进 .cache/。
ARG PYTHON_IMAGE=python:3.12.3-slim-bookworm
FROM ${PYTHON_IMAGE}

ARG FRAPPE_BRANCH=version-15
ARG BENCH_VERSION=5.31.0
ARG NODE_VERSION=22.13.0

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    PATH=/opt/node/bin:/home/frappe/.local/bin:$PATH \
    UV_HTTP_TIMEOUT=120 \
    PIP_DEFAULT_TIMEOUT=120

# 不用 Debian 的 nodejs/npm 包（依赖链长、镜像源易抖）：按 DevHost 同版本装官方 Node tarball，
# yarn 走 corepack（Node 自带）。apt 走 https 并对 update 做循环重试：deb.debian.org 偶发 502。
RUN printf '#!/bin/sh\nexit 101\n' > /usr/sbin/policy-rc.d && chmod +x /usr/sbin/policy-rc.d \
    && sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources \
    && for i in 1 2 3 4 5 6; do apt-get update -o Acquire::Retries=5 && break || sleep 8; done \
    && apt-get install -y --no-install-recommends -o Acquire::Retries=5 \
        git curl ca-certificates xz-utils build-essential default-libmysqlclient-dev \
        gettext redis-tools redis-server \
    && rm -rf /var/lib/apt/lists/* \
    && ARCH="$([ "$(uname -m)" = "aarch64" ] && echo arm64 || echo x64)" \
    && curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${ARCH}.tar.xz" \
        -o /tmp/node.tar.xz \
    && mkdir -p /opt/node \
    && tar -xJf /tmp/node.tar.xz -C /opt/node --strip-components=1 \
    && rm /tmp/node.tar.xz \
    && corepack enable \
    && node --version \
    && useradd -m -s /bin/bash frappe

USER frappe
WORKDIR /home/frappe

RUN pip install --user "frappe-bench==${BENCH_VERSION}"

# 本机到 npm 官方源（Cloudflare）易超时 → yarn/npm 走国内镜像并放宽超时；包版本不变，只换取包地址。
RUN yarn config set registry https://registry.npmmirror.com \
    && yarn config set network-timeout 600000 \
    && npm config set registry https://registry.npmmirror.com

# 本地 Frappe 源码（v15.118.0 tag 原版，来自 prepare.sh）→ 转成本地 git 仓库，
# bench init 从本地克隆，绕开 github 网络抖动；不打 DevHost 的离线补丁（6adff0dc 那套本地用不上）。
COPY --chown=frappe:frappe .cache/frappe-v15.118.0.tar.gz /tmp/frappe.tar.gz
RUN mkdir -p /home/frappe/frappe-src \
    && tar -xzf /tmp/frappe.tar.gz -C /home/frappe/frappe-src --strip-components=1 \
    && rm /tmp/frappe.tar.gz \
    && cd /home/frappe/frappe-src \
    && git init -q \
    && git add -A -f \
    && git -c user.email=build@local -c user.name=build commit -qm "frappe v15.118.0 (tag source)" \
    && git branch -f "${FRAPPE_BRANCH}"

# bench init：克隆走本地源；pip 走 pypi（uv，带超时重试）；yarn 走镜像。资产构建跳过——站点初始化后再 bench build。
RUN bench init frappe-bench --frappe-path /home/frappe/frappe-src --frappe-branch "${FRAPPE_BRANCH}" \
        --skip-assets --no-procfile --no-backups \
    && rm -rf ~/.cache

USER root
COPY scripts/init-site.sh scripts/start-frappe.sh scripts/sync-apps.sh /opt/shangshu/
RUN chmod +x /opt/shangshu/*.sh && mkdir -p /opt/shangshu/pristine && \
    cp -a /home/frappe/frappe-bench /opt/shangshu/pristine/frappe-bench && \
    chown -R frappe:frappe /opt/shangshu /home/frappe/frappe-bench

USER frappe
WORKDIR /home/frappe/frappe-bench
ENTRYPOINT ["/opt/shangshu/start-frappe.sh"]
