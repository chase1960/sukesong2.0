# 与 DevHost 对应的依赖版本锁（2026-10-10 在 DevHost 项目 shangshu-rework 现场实测）
# 用法：docker compose --env-file versions.env --env-file .env up
# 本文件的 diff 即版本变更的可观察交付物；改任何一行都要写明依据。

# Frappe：本地锁 v15.118.0 tag 原版源码（prepare.sh 放入 .cache/frappe-v15.118.0.tar.gz，构建不走 github 克隆）。
# DevHost 现场 git rev-parse = 6adff0dc（= v15.118.0 + 一个离线补丁提交，容器上不了网才打的），
# 本地有网不用该补丁，两边 Python 版本同为 15.118.0；差异仅 air-datepicker 取包方式。
FRAPPE_VERSION=15.118.0
FRAPPE_COMMIT_DEVHOST=6adff0dc4b0ad94ea8dc05dec3a5ad84101983f6
FRAPPE_BRANCH=version-15

# Python：DevHost .frappe-deploy/frappe-bench/env/bin/python --version = 3.12.3
PYTHON_IMAGE=python:3.12.3-slim-bookworm

# MariaDB：DevHost .frappe-deploy/mariadb-dist/bin/mariadbd = 10.11.19
# 注意：10.11 高于 Frappe v15 官方验证矩阵（≤10.8）；这里刻意与 DevHost 现场一致，
# 不是照官方矩阵改小——理由是本地/DevHost 行为一致优先，矩阵偏差已知并记录。
MARIADB_IMAGE=mariadb:10.11.19

# Redis：DevHost .frappe-deploy/bin/redis-server = 7.0.15
# socketio 与 cache 共用同一实例（DevHost common_site_config: redis_socketio = redis_cache = 13002），无第三路。
REDIS_IMAGE=redis:7.0.15

# Node：shangshu-server engines >=22.13.0；DevHost node_bin_dir = v22.13.0
# 2026-10-21 升位 22.13.0 → 22.20.0：**依据**＝Pi 编排器的门槛是 node ≥ 22.19
# （shangshu-server/src/core/chat-engines.ts：available = node ≥ 22.19）⇒ 22.13 下 Pi 引擎不出现。
# 另：镜像里那份依赖必须按**当前 lock** 装（否则运行时会撞「package-lock changed」那道闸）
# —— 重建脚本：ops/docker/scripts/build-node-image.sh <代码工作树>。
NODE_IMAGE=node:22.20.0-bookworm

# bench CLI：DevHost .frappe-deploy/bench-tools/bin/bench --version = 5.31.0
BENCH_VERSION=5.31.0

# 站点配置硬约束（kernel-delivery.md 实测坑）：max_file_size 必须是数字 33554432，
# bench set-config 会写成字符串导致上传 500，init-site.sh 直接改 JSON。
MAX_FILE_SIZE=33554432
