{
  "domain": "com.shangshu.files",
  "description": "文件/Excel 域真实边界。领域只依赖 shangshu_core.public_api（含已版本化的 organization 子模块）；禁止导入 core 私有组织实现。公共变更独立 CORE-CANDIDATE，跨域仅走公共契约，不扩大路径白名单。",
  "base_branch": "baseline/r967-20261021-integrated",
  "paths": {
    "allowed": [
      "frappe_apps/shangshu_files/",
      "shangshu-server/scripts/",
      "scripts/domain-policies/"
    ],
    "review_required": [
      "frappe_apps/shangshu_core/",
      "shangshu-server/src/",
      "shangshu-web/",
      "index.html",
      "ops/",
      "scripts/"
    ],
    "forbidden": [
      "frappe_apps/shangshu_mail/",
      "frappe_apps/shangshu_finance/",
      "frappe_apps/shangshu_orders/",
      "frappe_apps/shangshu_warehouse/",
      "frappe_apps/shangshu_ip/"
    ]
  },
  "immutable_after_base": [
    "frappe_apps/shangshu_core/shangshu_core/patches/",
    "frappe_apps/shangshu_files/shangshu_files/patches/"
  ],
  "content_rules": [
    {
      "id": "no-foreign-domain-import",
      "level": "forbidden",
      "pattern": "(?:from|import)\\s+shangshu_(?:mail|finance|orders|warehouse|ip)\\b",
      "extensions": [
        ".py",
        ".ts",
        ".js",
        ".mjs"
      ],
      "message": "不得直接依赖其他行业 App（偷依赖另一个行业）：跨域只走公共契约"
    }
  ],
  "default_path_classification": "review"
}
