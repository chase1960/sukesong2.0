{
  "doctype": "DocType",
  "name": "Shangshu Recruitment Intake",
  "module": "Shangshu Recruitment",
  "autoname": "REC-INTAKE-.YYYY.-.#####",
  "allow_rename": 0,
  "engine": "InnoDB",
  "field_order": [
    "enterprise_id",
    "source_type",
    "idempotency_key",
    "request_id",
    "created_by",
    "mail_account",
    "mail_message",
    "sender_email",
    "subject",
    "candidate_name",
    "candidate_email",
    "candidate_phone",
    "job_code",
    "attachments_json",
    "candidate",
    "matched_job",
    "status",
    "failure_code",
    "ignore_reason",
    "attempts",
    "received_at",
    "revision"
  ],
  "fields": [
    {"fieldname": "enterprise_id", "label": "企业", "fieldtype": "Data", "reqd": 1, "read_only": 1},
    {"fieldname": "source_type", "label": "来源类型", "fieldtype": "Select", "options": "mail\nmanual", "reqd": 1, "read_only": 1},
    {"fieldname": "idempotency_key", "label": "幂等键", "fieldtype": "Data", "reqd": 1, "read_only": 1},
    {"fieldname": "request_id", "label": "客户端请求号", "fieldtype": "Data", "read_only": 1},
    {"fieldname": "created_by", "label": "录入人", "fieldtype": "Link", "options": "User", "read_only": 1},
    {"fieldname": "mail_account", "label": "邮箱账号", "fieldtype": "Data", "read_only": 1},
    {"fieldname": "mail_message", "label": "来源邮件", "fieldtype": "Data", "read_only": 1},
    {"fieldname": "sender_email", "label": "发件邮箱", "fieldtype": "Data", "read_only": 1},
    {"fieldname": "subject", "label": "邮件主题", "fieldtype": "Data", "length": 500, "read_only": 1},
    {"fieldname": "candidate_name", "label": "候选人姓名", "fieldtype": "Data", "read_only": 1},
    {"fieldname": "candidate_email", "label": "候选人邮箱", "fieldtype": "Data", "length": 320, "read_only": 1},
    {"fieldname": "candidate_phone", "label": "候选人电话", "fieldtype": "Data", "read_only": 1},
    {"fieldname": "job_code", "label": "提取岗位编码", "fieldtype": "Data", "read_only": 1},
    {"fieldname": "attachments_json", "label": "附件清单", "fieldtype": "Long Text", "read_only": 1},
    {"fieldname": "candidate", "label": "候选人", "fieldtype": "Link", "options": "Shangshu Recruitment Candidate", "read_only": 1},
    {"fieldname": "matched_job", "label": "匹配岗位", "fieldtype": "Link", "options": "Shangshu Recruitment Job", "read_only": 1},
    {"fieldname": "status", "label": "状态", "fieldtype": "Select", "options": "received\nneeds_assignment\nprocessing\nconverted\nignored\nneeds_manual\nfailed", "reqd": 1, "read_only": 1},
    {"fieldname": "failure_code", "label": "失败码", "fieldtype": "Data", "read_only": 1},
    {"fieldname": "ignore_reason", "label": "忽略原因", "fieldtype": "Long Text", "read_only": 1},
    {"fieldname": "attempts", "label": "重试次数", "fieldtype": "Int", "reqd": 1, "read_only": 1, "default": "0"},
    {"fieldname": "received_at", "label": "收到时间", "fieldtype": "Datetime", "reqd": 1, "read_only": 1},
    {"fieldname": "revision", "label": "修订", "fieldtype": "Int", "reqd": 1, "read_only": 1}
  ],
  "permissions": [
    {"role": "Recruitment Admin", "read": 1, "write": 1},
    {"role": "Recruiter", "read": 1, "write": 1},
    {"role": "System Manager", "read": 1, "write": 1}
  ]
}
