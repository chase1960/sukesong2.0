{
  "doctype": "DocType",
  "name": "Shangshu Recruitment Interview",
  "module": "Shangshu Recruitment",
  "autoname": "REC-INT-.YYYY.-.#####",
  "allow_rename": 0,
  "engine": "InnoDB",
  "field_order": [
    "enterprise_id",
    "application",
    "round",
    "stage",
    "scheduled_at",
    "interviewer",
    "status",
    "result",
    "note",
    "completed_at",
    "revision"
  ],
  "fields": [
    {"fieldname": "enterprise_id", "label": "企业", "fieldtype": "Data", "reqd": 1, "read_only": 1},
    {"fieldname": "application", "label": "申请", "fieldtype": "Link", "options": "Shangshu Recruitment Application", "reqd": 1, "read_only": 1},
    {"fieldname": "round", "label": "轮次", "fieldtype": "Int", "reqd": 1},
    {"fieldname": "stage", "label": "面试环节", "fieldtype": "Data", "length": 80, "reqd": 1},
    {"fieldname": "scheduled_at", "label": "计划时间", "fieldtype": "Datetime", "reqd": 1},
    {"fieldname": "interviewer", "label": "面试官", "fieldtype": "Link", "options": "User", "reqd": 1, "read_only": 1},
    {"fieldname": "status", "label": "状态", "fieldtype": "Select", "options": "scheduled\ncompleted\ncancelled", "default": "scheduled", "reqd": 1, "read_only": 1},
    {"fieldname": "result", "label": "结果", "fieldtype": "Select", "options": "\npass\nfail", "read_only": 1},
    {"fieldname": "note", "label": "备注", "fieldtype": "Long Text", "read_only": 1},
    {"fieldname": "completed_at", "label": "完成时间", "fieldtype": "Datetime", "read_only": 1},
    {"fieldname": "revision", "label": "修订", "fieldtype": "Int", "reqd": 1, "read_only": 1, "default": "1"}
  ],
  "permissions": [
    {"role": "Recruitment Admin", "read": 1, "write": 1},
    {"role": "Recruiter", "read": 1, "write": 1},
    {"role": "Hiring Manager", "read": 1},
    {"role": "System Manager", "read": 1, "write": 1}
  ]
}
