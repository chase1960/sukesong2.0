{
  "doctype": "DocType",
  "name": "Shangshu Process Definition Version",
  "module": "Shangshu Core",
  "autoname": "field:version_id",
  "allow_rename": 0,
  "engine": "InnoDB",
  "field_order": [
    "version_id",
    "definition",
    "version_number",
    "graph_hash",
    "graph_json",
    "dependency_snapshot_json",
    "published_by",
    "published_at"
