    },
    {
      "fieldname": "read_at",
      "label": "读信时间",
      "fieldtype": "Datetime",
      "reqd": 1
    }
  ],
  "permissions": [
    {
      "role": "Desk User",
      "read": 0,
      "write": 0,
      "create": 0,
      "delete": 0
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC"
