{
  "doctype": "DocType",
  "name": "Shangshu Expense Claim",
  "module": "Shangshu Finance",
  "autoname": "EXP-.YYYY.-.#####",
  "allow_rename": 0,
  "engine": "InnoDB",
  "is_submittable": 1,
  "track_changes": 1,
  "title_field": "subject",
  "field_order": [
    "subject",
    "applicant",
    "invoice",
    "amount",
    "expense_date",
    "department",
    "cost_center",
    "purpose",
    "payment_recipient",
    "workflow_state",
    "process_instance",
    "record_version",
    "manager_note",
    "finance_note",
    "supplement_note"
  ],
  "fields": [
    {
      "fieldname": "subject",
      "fieldtype": "Data",
      "label": "报销事项",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "applicant",
      "fieldtype": "Link",
      "label": "申请人",
      "options": "User",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "invoice",
      "fieldtype": "Link",
      "label": "发票",
      "options": "Shangshu Finance Invoice",
      "reqd": 1,
      "unique": 1
    },
    {
      "fieldname": "amount",
      "fieldtype": "Currency",
      "label": "报销金额",
      "reqd": 1,
      "in_list_view": 1,
      "precision": "2"
    },
    {
      "fieldname": "expense_date",
      "fieldtype": "Date",
      "label": "费用日期",
      "reqd": 1
    },
    {
      "fieldname": "department",
      "fieldtype": "Data",
      "label": "部门",
      "reqd": 1
    },
    {
      "fieldname": "cost_center",
      "fieldtype": "Data",
      "label": "成本归属",
      "reqd": 1
    },
    {
      "fieldname": "purpose",
      "fieldtype": "Small Text",
      "label": "用途说明",
      "reqd": 1
    },
    {
      "fieldname": "payment_recipient",
      "fieldtype": "Link",
      "label": "付款对象",
      "options": "User",
      "reqd": 1
    },
    {
      "fieldname": "workflow_state",
      "fieldtype": "Link",
      "label": "流程状态",
      "options": "Workflow State",
      "read_only": 1,
      "allow_on_submit": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "process_instance",
      "fieldtype": "Link",
      "label": "流程实例",
      "options": "Shangshu Process Instance",
      "read_only": 1
    },
    {
      "fieldname": "record_version",
      "fieldtype": "Int",
      "label": "记录版本",
      "default": 1,
      "reqd": 1
    },
    {
      "fieldname": "manager_note",
      "fieldtype": "Small Text",
      "label": "经理意见",
      "allow_on_submit": 1
    },
    {
      "fieldname": "finance_note",
      "fieldtype": "Small Text",
      "label": "财务意见",
      "allow_on_submit": 1
    },
    {
      "fieldname": "supplement_note",
      "fieldtype": "Small Text",
      "label": "补充说明",
      "allow_on_submit": 1
    }
  ],
  "permissions": [
    {
      "role": "Desk User",
      "read": 1,
      "create": 1,
      "write": 1,
      "submit": 1
    },
    {
      "role": "Expense Approver",
      "read": 1,
      "write": 1,
      "submit": 1
    },
    {
      "role": "Finance Approver",
      "read": 1,
      "write": 1,
      "submit": 1
    },
    {
      "role": "Cashier",
      "read": 1,
      "write": 1
    },
    {
      "role": "System Manager",
      "read": 1,
      "create": 1,
      "write": 1,
      "submit": 1,
      "cancel": 1
    }
  ]
}
