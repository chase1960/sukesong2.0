{
  "doctype": "DocType",
  "name": "Shangshu Payable",
  "module": "Shangshu Finance",
  "autoname": "PAY-.YYYY.-.#####",
  "allow_rename": 0,
  "engine": "InnoDB",
  "track_changes": 1,
  "field_order": [
    "expense_claim",
    "recipient",
    "amount",
    "paid_amount",
    "balance_amount",
    "status",
    "record_version",
    "expense_posting_batch",
    "payment_posting_batch"
  ],
  "fields": [
    {
      "fieldname": "expense_claim",
      "fieldtype": "Link",
      "label": "报销单",
      "options": "Shangshu Expense Claim",
      "reqd": 1,
      "unique": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "recipient",
      "fieldtype": "Link",
      "label": "收款人",
      "options": "User",
      "reqd": 1
    },
    {
      "fieldname": "amount",
      "fieldtype": "Currency",
      "label": "应付金额",
      "reqd": 1,
      "precision": "2"
    },
    {
      "fieldname": "paid_amount",
      "fieldtype": "Currency",
      "label": "已付金额",
      "default": 0,
      "reqd": 1,
      "precision": "2"
    },
    {
      "fieldname": "balance_amount",
      "fieldtype": "Currency",
      "label": "余额",
      "reqd": 1,
      "precision": "2",
      "in_list_view": 1
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "状态",
      "options": "Open\nPaid\nReversed",
      "default": "Open",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "record_version",
      "fieldtype": "Int",
      "label": "记录版本",
      "default": 1,
      "reqd": 1
    },
    {
      "fieldname": "expense_posting_batch",
      "fieldtype": "Link",
      "label": "费用过账批次",
      "options": "Shangshu Posting Batch",
      "reqd": 1
    },
    {
      "fieldname": "payment_posting_batch",
      "fieldtype": "Link",
      "label": "付款批次",
      "options": "Shangshu Posting Batch"
    }
  ],
  "permissions": [
    {
      "role": "Finance Approver",
      "read": 1,
      "create": 1,
      "write": 1
    },
    {
      "role": "Cashier",
      "read": 1,
      "write": 1
    },
    {
      "role": "System Manager",
      "read": 1,
      "create": 1,
      "write": 1
    }
  ]
}
